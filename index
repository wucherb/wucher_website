<script>
  // Nav shadow on scroll
  const navbar = document.getElementById('navbar');
  window.addEventListener('scroll', () => {
    navbar.classList.toggle('scrolled', window.scrollY > 50);
  }, { passive: true });

  // Scroll-triggered section reveal
  const revealObserver = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('is-visible');
        revealObserver.unobserve(entry.target);
      }
    });
  }, { threshold: 0.1 });

  document.querySelectorAll('.reveal').forEach(el => revealObserver.observe(el));

  // Floating research sidebar — stays fixed at left edge the entire time
  (function () {
    const sidebar = document.getElementById('research-sidebar');
    const researchSection = document.getElementById('research');
    if (!sidebar || !researchSection) return;
    const STICKY_TOP = 52 + 40;
    const COLOR_RANGE = 220;

    let fixedLeft = 0;
    function measure() {
      fixedLeft = parseFloat(getComputedStyle(researchSection).paddingLeft) || 52;
    }
    function lerp(a, b, t) { return a + (b - a) * t; }

    function update() {
      if (window.innerWidth <= 880) {
        sidebar.classList.remove('sidebar-fixed');
        sidebar.style.removeProperty('left');
        sidebar.style.removeProperty('top');
        sidebar.style.removeProperty('--sb-txt');
        sidebar.style.removeProperty('--sb-txt2');
        sidebar.style.removeProperty('--sb-border');
        return;
      }

      const resTop    = researchSection.getBoundingClientRect().top;
      const resBottom = researchSection.getBoundingClientRect().bottom;
      const sidebarH  = sidebar.offsetHeight;

      if (resBottom <= 0) {
        // Research section fully above viewport — remove sidebar
        sidebar.classList.remove('sidebar-fixed');
        sidebar.style.removeProperty('left');
        sidebar.style.removeProperty('top');
      } else if (resBottom <= STICKY_TOP + sidebarH) {
        // Section ending — slide sidebar up with the section bottom
        sidebar.classList.add('sidebar-fixed');
        sidebar.style.left = fixedLeft + 'px';
        sidebar.style.top  = (resBottom - sidebarH) + 'px';
      } else {
        // Normal — sidebar pinned at STICKY_TOP, left edge fixed
        sidebar.classList.add('sidebar-fixed');
        sidebar.style.left = fixedLeft + 'px';
        sidebar.style.removeProperty('top'); // falls back to CSS value
      }

      // Scroll-synced color interpolation (p=0 dark, p=1 light/hero)
      const p = Math.max(0, Math.min(1, (resTop - STICKY_TOP) / COLOR_RANGE));
      const v  = Math.round(lerp(17,  255, p));
      sidebar.style.setProperty('--sb-txt',    `rgb(${v},${v},${v})`);
      const v2 = Math.round(lerp(74,  255, p));
      const a2 = lerp(1, 0.70, p);
      sidebar.style.setProperty('--sb-txt2',   `rgba(${v2},${v2},${v2},${a2.toFixed(2)})`);
      const vb = Math.round(lerp(229, 255, p));
      const ab = lerp(1, 0.15, p);
      sidebar.style.setProperty('--sb-border', `rgba(${vb},${vb},${vb},${ab.toFixed(2)})`);
    }

    let raf = null;
    function onScroll() {
      if (raf) return;
      raf = requestAnimationFrame(() => { raf = null; update(); });
    }

    measure();
    update();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', () => { measure(); update(); });
  }());

  // Active nav link scrollspy
  const sections = document.querySelectorAll('section[id]');
  const navLinks = document.querySelectorAll('.nav-links a');

  const spyObserver = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        navLinks.forEach(link => {
          link.classList.toggle('active', link.getAttribute('href') === '#' + entry.target.id);
        });
      }
    });
  }, { rootMargin: '0px 0px -70% 0px' });

  sections.forEach(s => spyObserver.observe(s));
</script>

