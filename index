<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Benjamin R. Wucher — Postdoctoral Fellow at Memorial Sloan Kettering Cancer Center. Research in microbial ecology, biofilm architecture, and single-cell imaging.">
  <title>Benjamin R. Wucher · Microbiologist</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=Space+Mono:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet">
  <style>
    /* ── TOKENS ── */
    :root {
      --bg:           #FFFFFF;
      --surface:      #F0F0F0;
      --ink:          #111111;
      --ink-2:        #4A4A4A;
      --ink-3:        #999999;
      --accent:       #F46A0D;
      --rule:         #E5E5E5;
      --rule-strong:  #CCCCCC;
      --nav-h:        52px;
      --max-w:        1160px;
      --pad:          52px;
      --mono:         'Space Mono', monospace;
    }
    @media (max-width: 768px) { :root { --pad: 24px; } }

    /* ── RESET ── */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body {
      font-family: 'Space Grotesk', system-ui, sans-serif;
      background: var(--bg);
      color: var(--ink);
      line-height: 1.65;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
    }

    /* ── FADE-IN ── */
    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(16px); }
      to   { opacity: 1; transform: translateY(0); }
    }
    .fade-in { opacity: 0; animation: fadeUp 0.7s ease forwards; }
    .d1 { animation-delay: 0.05s; }
    .d2 { animation-delay: 0.18s; }
    .d3 { animation-delay: 0.32s; }

    /* ── NAV ── */
    nav {
      position: fixed;
      inset: 0 0 auto 0;
      height: var(--nav-h);
      z-index: 100;
      background: #fff;
      border-bottom: 1px solid var(--rule);
      border-top: 2px solid var(--accent);
    }
    .nav-inner {
      max-width: calc(var(--max-w) + var(--pad) * 2);
      margin: 0 auto;
      height: 100%;
      padding: 0 var(--pad);
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .nav-logo {
      font-family: var(--mono);
      font-size: 0.6rem;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      text-decoration: none;
      color: var(--ink);
    }
    .nav-links {
      list-style: none;
      display: flex;
      gap: 28px;
    }
    .nav-links a {
      font-family: var(--mono);
      font-size: 0.55rem;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      text-decoration: none;
      color: var(--ink-2);
      transition: color 0.2s;
    }
    .nav-links a:hover { color: var(--accent); }
    @media (max-width: 640px) { .nav-links { display: none; } }

    /* ── SHARED ── */
    .tag {
      font-family: var(--mono);
      font-size: 0.52rem;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--accent);
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 20px;
      width: 100%;
    }
    .tag::before {
      content: '';
      display: block;
      width: 28px;
      height: 1px;
      background: var(--accent);
      flex-shrink: 0;
    }
    .tag::after {
      content: '';
      flex: 1;
      height: 1px;
      background: var(--rule);
    }
    .h-section {
      font-size: clamp(1.7rem, 3vw, 2.6rem);
      font-weight: 700;
      letter-spacing: -0.025em;
      line-height: 1.05;
      padding-bottom: 20px;
      border-bottom: 1px solid var(--rule);
      margin-bottom: 40px;
    }

    /* ── HERO ── */
    #home {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      padding: calc(var(--nav-h) + 48px) var(--pad) 72px;
      position: relative;
      overflow: hidden;
    }
    .hero-bg {
      position: absolute;
      inset: 0;
      background-image: url('pnas-cover.png');
      background-size: cover;
      background-position: center right;
      z-index: 0;
    }
    /* gradient: opaque dark on left for text, fading to transparent on right */
    .hero-bg::after {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(
        to right,
        rgba(0, 0, 0, 0.92) 0%,
        rgba(0, 0, 0, 0.72) 38%,
        rgba(0, 0, 0, 0.18) 70%,
        rgba(0, 0, 0, 0.0) 100%
      );
    }
    .hero-wrap {
      max-width: var(--max-w);
      margin: 0 auto;
      width: 100%;
      display: grid;
      grid-template-columns: 1fr 240px;
      grid-template-rows: auto;
      gap: 0 64px;
      align-items: end;
      position: relative;
      z-index: 1;
    }
    .hero-left { display: flex; flex-direction: column; }
    .hero-mark { display: none; }
    .hero-name {
      font-size: clamp(3.5rem, 8vw, 7.5rem);
      font-weight: 700;
      letter-spacing: -0.04em;
      line-height: 0.92;
      margin-bottom: 52px;
      color: #FFFFFF;
    }
    .hero-rule {
      width: 100%;
      height: 1px;
      background: rgba(255,255,255,0.18);
      margin-bottom: 0;
    }
    .hero-specs {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 0;
    }
    .spec {
      display: flex;
      flex-direction: column;
      gap: 4px;
      padding: 12px 16px;
      border-top: 1px solid rgba(255,255,255,0.18);
    }
    .spec-label {
      font-family: var(--mono);
      font-size: 0.44rem;
      letter-spacing: 0.28em;
      text-transform: uppercase;
      color: rgba(255,255,255,0.45);
    }
    .spec-value {
      font-size: 0.82rem;
      font-weight: 500;
      color: rgba(255,255,255,0.82);
    }
    .hero-photo-wrap {
      align-self: end;
      position: relative;
    }
    .hero-photo {
      display: block;
      width: 100%;
      aspect-ratio: 3 / 4;
      object-fit: cover;
      object-position: center top;
      filter: sepia(12%) contrast(1.04);
    }
    @media (max-width: 720px) {
      .hero-bg { background-position: center center; }
      .hero-bg::after {
        background: linear-gradient(
          to bottom,
          rgba(0,0,0,0.55) 0%,
          rgba(0,0,0,0.80) 60%,
          rgba(0,0,0,0.92) 100%
        );
      }
      .hero-wrap { grid-template-columns: 1fr; }
      .hero-photo-wrap { display: none; }
      .hero-specs { grid-template-columns: 1fr 1fr; }
    }
    @media (max-width: 380px) { .hero-specs { grid-template-columns: 1fr; } }

    /* ── SIDEBAR SCROLL BEHAVIOUR ── */
    .research-sidebar.sidebar-fixed {
      position: fixed;
      top: calc(var(--nav-h) + 40px);
      width: 260px;
      z-index: 50;
    }
    .research-sidebar.sidebar-fixed ~ .research-text {
      grid-column: 2;
    }
    /* Colors driven by JS-interpolated custom properties for scroll-synced transitions */
    .research-sidebar .h-section {
      color: var(--sb-txt, var(--ink));
      border-color: var(--sb-border, var(--rule));
    }
    .research-sidebar .keyword-list li {
      color: var(--sb-txt2, var(--ink-2));
      border-color: var(--sb-border, var(--rule));
    }
    .research-sidebar .keyword-list li:first-child {
      border-top-color: var(--sb-border, var(--rule));
    }
    .research-sidebar .kw-item-link {
      color: var(--sb-txt2, var(--ink-2));
    }
    .research-sidebar .kw-item-link:hover { color: var(--accent); }
    .research-sidebar .tag::after {
      background: var(--sb-border, var(--rule));
    }

    /* ── RESEARCH ── */
    #research { padding: 120px var(--pad); }
    .research-wrap {
      max-width: var(--max-w);
      margin: 0 auto;
      display: grid;
      grid-template-columns: 260px 1fr;
      gap: 100px;
      align-items: start;
    }
    .research-sidebar {
      position: sticky;
      top: calc(var(--nav-h) + 40px);
    }
    .keyword-list {
      list-style: none;
      margin-top: 28px;
      counter-reset: kw;
    }
    .keyword-list li {
      font-family: var(--mono);
      font-size: 0.6rem;
      letter-spacing: 0.06em;
      color: var(--ink-2);
      padding: 8px 0;
      border-bottom: 1px solid var(--rule);
      display: flex;
      justify-content: space-between;
      align-items: center;
      counter-increment: kw;
    }
    .keyword-list li:first-child { border-top: 1px solid var(--rule); }
    .keyword-list li::after {
      content: counter(kw, decimal-leading-zero);
      font-size: 0.46rem;
      letter-spacing: 0.1em;
      color: var(--accent);
    }
    .kw-item-link {
      color: inherit;
      text-decoration: none;
      display: flex;
      align-items: center;
      gap: 8px;
      transition: color 0.2s;
    }
    .kw-item-link:hover { color: var(--accent); }
    .kw-arrow {
      color: var(--accent);
      font-size: 0.7rem;
      line-height: 1;
      flex-shrink: 0;
    }
    .research-text {
      display: flex;
      flex-direction: column;
      gap: 0;
      padding-top: 4px;
      counter-reset: para;
    }
    .research-text p {
      font-size: 0.97rem;
      line-height: 1.75;
      color: var(--ink);
      padding: 20px 0 20px 36px;
      border-bottom: 1px solid var(--rule);
      position: relative;
      counter-increment: para;
    }
    .research-text p:first-child { border-top: 1px solid var(--rule); }
    .research-text p::before {
      content: '¶' counter(para, decimal-leading-zero);
      position: absolute;
      left: 0;
      top: 22px;
      font-family: var(--mono);
      font-size: 0.44rem;
      letter-spacing: 0.1em;
      color: var(--accent);
      line-height: 1;
    }
    @media (max-width: 880px) {
      .research-wrap { grid-template-columns: 1fr; gap: 56px; }
      .research-sidebar { position: static; }
    }

    /* ── GALLERY ── */
    #gallery {
      background: #141210;
      padding: 80px var(--pad);
    }
    .gallery-wrap {
      max-width: var(--max-w);
      margin: 0 auto;
    }
    .gallery-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 3px;
      margin-top: 48px;
    }
    .gallery-item { display: flex; flex-direction: column; gap: 0; }
    .gallery-item img {
      display: block;
      width: 100%;
      aspect-ratio: 4 / 3;
      object-fit: cover;
    }
    .gallery-caption {
      padding: 14px 0 0;
      display: flex;
      flex-direction: column;
      gap: 4px;
    }
    .gallery-caption-title {
      font-family: 'Space Mono', monospace;
      font-size: 0.6rem;
      letter-spacing: 0.04em;
      color: rgba(255,255,255,0.5);
      line-height: 1.5;
    }
    .gallery-caption-source {
      font-family: 'Space Mono', monospace;
      font-size: 0.6rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: rgba(255,255,255,0.4);
    }
    .gallery-tag { color: rgba(255,255,255,0.25); }
    .gallery-tag::before { background: rgba(255,255,255,0.25); }
    @media (max-width: 640px) {
      .gallery-grid { grid-template-columns: 1fr; gap: 32px; }
    }

    /* ── PUBLICATIONS ── */
    #publications {
      background: var(--bg);
      padding: 120px var(--pad);
    }
    .pub-wrap {
      max-width: var(--max-w);
      margin: 0 auto;
    }
    .pub-list {
      list-style: none;
      margin-top: 40px;
      counter-reset: pub;
    }
    .pub-item {
      display: grid;
      grid-template-columns: 72px 1fr;
      gap: 28px;
      padding: 22px 0;
      border-top: 1px solid var(--rule);
      counter-increment: pub;
    }
    .pub-item:last-child { border-bottom: 1px solid var(--rule); }
    .pub-year {
      font-family: var(--mono);
      font-size: 0.65rem;
      font-weight: 700;
      color: var(--accent);
      padding-top: 3px;
      letter-spacing: 0.04em;
    }
    .pub-year::before {
      display: block;
      content: counter(pub, decimal-leading-zero);
      font-size: 0.44rem;
      font-weight: 400;
      letter-spacing: 0.12em;
      color: var(--ink-3);
      margin-bottom: 5px;
    }
    .pub-year span {
      display: block;
      font-weight: 400;
      color: var(--ink-3);
      font-size: 0.56rem;
      margin-top: 4px;
      letter-spacing: 0.06em;
    }
    .pub-body { display: flex; flex-direction: column; gap: 6px; }
    .pub-title {
      font-size: 0.95rem;
      font-weight: 600;
      line-height: 1.4;
      color: var(--ink);
    }
    .pub-title a {
      color: inherit;
      text-decoration: none;
      border-bottom: 1px solid var(--rule);
      transition: color 0.2s, border-color 0.2s;
    }
    .pub-title a:hover { color: var(--accent); border-color: var(--accent); }
    .pub-journal {
      font-family: var(--mono);
      font-size: 0.6rem;
      color: var(--ink-2);
      letter-spacing: 0.03em;
      line-height: 1.5;
    }
    .pub-authors {
      font-size: 0.78rem;
      color: var(--ink-3);
      line-height: 1.55;
    }
    .pub-authors b { color: var(--ink-2); font-weight: 600; }
    .pub-item.prep .pub-title { font-style: italic; color: var(--ink-2); }
    .pub-item.prep .pub-year { color: var(--ink-3); }
    .pub-subhead {
      font-family: var(--mono);
      font-size: 0.52rem;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--ink-3);
      padding: 24px 0 6px;
      grid-column: 1 / -1;
      border-top: 1px solid var(--rule);
      margin-top: 4px;
    }
    @media (max-width: 560px) {
      .pub-item { grid-template-columns: 1fr; gap: 6px; }
    }

    /* ── BACKGROUND ── */
    #background { padding: 120px var(--pad); }
    .bg-wrap {
      max-width: var(--max-w);
      margin: 0 auto;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 100px;
      align-items: start;
    }
    .bg-block { display: flex; flex-direction: column; }
    .edu-list, .award-list { list-style: none; margin-top: 40px; }
    .edu-item {
      padding: 18px 0;
      border-top: 1px solid var(--rule);
      display: flex;
      flex-direction: column;
      gap: 4px;
    }
    .edu-item:last-child { border-bottom: 1px solid var(--rule); }
    .edu-year {
      font-family: var(--mono);
      font-size: 0.52rem;
      letter-spacing: 0.14em;
      color: var(--ink-3);
      margin-bottom: 2px;
      text-transform: uppercase;
    }
    .edu-degree {
      font-size: 0.9rem;
      font-weight: 600;
      color: var(--ink);
    }
    .edu-inst {
      font-size: 0.82rem;
      color: var(--ink-2);
      font-weight: 500;
    }
    .edu-detail {
      font-family: var(--mono);
      font-size: 0.58rem;
      color: var(--ink-3);
      letter-spacing: 0.02em;
      line-height: 1.65;
      margin-top: 3px;
    }
    .award-item {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: 16px;
      padding: 10px 0;
      border-top: 1px solid var(--rule);
    }
    .award-item:last-child { border-bottom: 1px solid var(--rule); }
    .award-name {
      font-size: 0.82rem;
      color: var(--ink);
      font-weight: 500;
      line-height: 1.4;
    }
    .award-year {
      font-family: var(--mono);
      font-size: 0.55rem;
      color: var(--ink-3);
      letter-spacing: 0.08em;
      white-space: nowrap;
      flex-shrink: 0;
    }
    @media (max-width: 880px) {
      .bg-wrap { grid-template-columns: 1fr; gap: 72px; }
    }

    /* ── CONTACT ── */
    #contact { padding: 120px var(--pad); background: var(--bg); }
    .contact-wrap {
      max-width: var(--max-w);
      margin: 0 auto;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 100px;
      align-items: start;
    }
    .contact-note {
      margin-top: 28px;
      font-size: 0.935rem;
      color: var(--ink-2);
      line-height: 1.8;
      max-width: 340px;
    }
    .contact-links { list-style: none; }
    .contact-link {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      padding: 13px 0;
      border-top: 1px solid var(--rule);
      text-decoration: none;
      color: var(--ink);
      transition: color 0.2s;
    }
    .contact-links li:last-child .contact-link { border-bottom: 1px solid var(--rule); }
    .contact-link:hover { color: var(--accent); }
    .contact-link:hover .cl-arrow { color: var(--accent); }
    .cl-left { display: flex; flex-direction: column; gap: 3px; }
    .cl-label {
      font-family: var(--mono);
      font-size: 0.5rem;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--ink-3);
    }
    .cl-value { font-size: 0.85rem; font-weight: 500; }
    .cl-arrow { font-size: 0.9rem; color: var(--ink-3); transition: color 0.2s; flex-shrink: 0; }
    @media (max-width: 768px) { .contact-wrap { grid-template-columns: 1fr; gap: 56px; } }

    /* ── TE / BRAUN SYSTEM TOUCHES ── */
    /* Extend tag rule across the full container width */
    .tag { width: 100%; }
    .tag::after {
      content: '';
      flex: 1;
      height: 1px;
      background: var(--rule);
    }
    /* plain white backgrounds — no dot grid */
    #research, #background { background: var(--bg); }
    /* More prominent section counters */
    .section-num {
      font-family: 'Space Mono', monospace;
      font-size: 0.58rem;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--ink-3);
      display: block;
      margin-bottom: 10px;
    }

    /* ── GALLERY EXTENDED ── */
    /* Group separators */
    .gallery-group { margin-top: 52px; }
    .gallery-group-bar {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      padding: 13px 0 20px;
      border-top: 1px solid rgba(255,255,255,0.1);
    }
    .ggb-label {
      font-family: 'Space Mono', monospace;
      font-size: 0.63rem;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: rgba(255,255,255,0.5);
    }
    .ggb-meta {
      font-family: 'Space Mono', monospace;
      font-size: 0.57rem;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: rgba(255,255,255,0.2);
    }
    /* Postdoc layout: full-width on top, two renders side-by-side below */
    .gallery-postdoc { display: flex; flex-direction: column; gap: 3px; }
    .gallery-grid-2 {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 3px;
    }
    /* Image wrapper with channel overlay */
    .gallery-img-wrap {
      position: relative;
      overflow: hidden;
      display: block;
    }
    /* Full-width crypt image */
    .gallery-item--full .gallery-img-wrap img {
      display: block;
      width: 100%;
      aspect-ratio: 16 / 14;
      object-fit: cover;
      object-position: center top;
      transform: scale(1.18);
      transform-origin: top center;
    }
    /* Secondary row images — contain so nothing is cropped, dark fill */
    .gallery-grid-2 .gallery-img-wrap img {
      display: block;
      width: 100%;
      aspect-ratio: 4 / 3;
      object-fit: contain;
      background: #0D0B09;
    }
    .gallery-channels {
      position: absolute;
      bottom: 8px;
      left: 8px;
      display: flex;
      gap: 4px;
      opacity: 0.9;
    }
    .ch {
      font-family: 'Space Mono', monospace;
      font-size: 0.47rem;
      letter-spacing: 0.12em;
      padding: 2px 5px;
      border: 1px solid;
      text-transform: uppercase;
      line-height: 1.6;
    }
    .ch-red  { color: #FF5044; border-color: rgba(255,80,68,0.5); }
    .ch-cyan { color: #00D4C8; border-color: rgba(0,212,200,0.5); }
    @media (max-width: 640px) {
      .gallery-grid-2 { grid-template-columns: 1fr; gap: 28px; }
      .gallery-group-bar { flex-direction: column; gap: 4px; }
      .ggb-meta { display: none; }
    }

    /* ── NAV SCROLLED ── */
    nav.scrolled {
      box-shadow: 0 1px 24px rgba(0,0,0,0.07);
    }

    /* ── SCROLL REVEAL ── */
    .reveal {
      opacity: 0;
      transform: translateY(28px);
      transition: opacity 0.75s ease, transform 0.75s ease;
    }
    .reveal.is-visible {
      opacity: 1;
      transform: none;
    }

    /* ── ACTIVE NAV LINK ── */
    .nav-links a.active { color: var(--accent); }

    /* ── FOOTER ── */
    footer { border-top: 2px solid var(--rule-strong); padding: 20px var(--pad); }
    .footer-inner {
      max-width: var(--max-w);
      margin: 0 auto;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 16px;
    }
    .footer-text {
      font-family: var(--mono);
      font-size: 0.5rem;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--ink-3);
    }
